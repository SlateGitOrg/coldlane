      <column caption='Excursion Rate' datatype='real' name='[Calculation_2025110100000002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_excursion]) / COUNTD([shipment_id])' />
      </column>
      <column caption='Indeterminate Rate' datatype='real' name='[Calculation_2025110100000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_indeterminate]) / COUNTD([shipment_id])' />
      </column>
      <column caption='Reject Rate' datatype='real' name='[Calculation_2025110100000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_reject]) / COUNTD([shipment_id])' />
      </column>
      <column caption='Avg MKT' datatype='real' name='[Calculation_2025110100000006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([mkt_c])' />
      </column>
    </datasource>
