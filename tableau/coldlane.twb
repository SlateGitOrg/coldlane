      <column caption='Excursion Minutes' datatype='real' name='[Calculation_2025110100000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([excursion_minutes])' />
      </column>
      <column caption='Cumulative Excursion %' datatype='real' name='[Calculation_2025110100000007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([excursion_minutes])) / TOTAL(SUM([excursion_minutes]))' />
      </column>
    </datasource>
    <datasource caption='lot_budget' inline='true' name='federated.0coldlane0lotbudget' version='18.1'>
      <connection class='federated'>
