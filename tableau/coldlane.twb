  <worksheets>
    <worksheet name='Lane x Leg Heatmap'>
      <layout-options><title><formatted-text><run>Excursion minutes by lane and leg</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='leg_excursions' name='federated.0coldlane0legexcursions' /></datasources>
          <datasource-dependencies datasource='federated.0coldlane0legexcursions'>
            <column datatype='string' name='[lane_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[leg]' role='dimension' type='nominal' />
            <column datatype='integer' name='[leg_seq]' role='measure' type='quantitative' />
            <column caption='Excursion Minutes' datatype='real' name='[Calculation_2025110100000001]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([excursion_minutes])' /></column>
            <column-instance column='[lane_id]' derivation='None' name='[none:lane_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[leg]' derivation='None' name='[none:leg:nk]' pivot='key' type='nominal' />
            <column-instance column='[leg_seq]' derivation='Min' name='[min:leg_seq:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2025110100000001]' derivation='User' name='[usr:Calculation_2025110100000001:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0coldlane0legexcursions].[none:leg:nk]' direction='ASC' using='[federated.0coldlane0legexcursions].[min:leg_seq:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000001:qk]' />
              <text column='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000001:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0coldlane0legexcursions].[none:lane_id:nk]</rows>
        <cols>[federated.0coldlane0legexcursions].[none:leg:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Hub Pareto'>
      <layout-options><title><formatted-text><run>Excursion minutes by site, largest first, with cumulative share</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='leg_excursions' name='federated.0coldlane0legexcursions' /></datasources>
          <datasource-dependencies datasource='federated.0coldlane0legexcursions'>
            <column datatype='string' name='[site]' role='dimension' type='nominal' />
            <column caption='Excursion Minutes' datatype='real' name='[Calculation_2025110100000001]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([excursion_minutes])' /></column>
            <column caption='Cumulative Excursion %' datatype='real' name='[Calculation_2025110100000007]' role='measure' type='quantitative'><calculation class='tableau' formula='RUNNING_SUM(SUM([excursion_minutes])) / TOTAL(SUM([excursion_minutes]))' /></column>
            <column-instance column='[site]' derivation='None' name='[none:site:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2025110100000001]' derivation='User' name='[usr:Calculation_2025110100000001:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2025110100000007]' derivation='User' name='[usr:Calculation_2025110100000007:qk:2]' pivot='key' type='quantitative'><table-calc ordering-type='Columns' /></column-instance>
          </datasource-dependencies>
          <computed-sort column='[federated.0coldlane0legexcursions].[none:site:nk]' direction='DESC' using='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000001:qk]' />
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='text-format' field='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000007:qk:2]' value='p0%' /></style-rule></style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000001:qk]' />
            </encodings>
          </pane>
          <pane y-axis-name='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000007:qk:2]' y-index='1'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <text column='[federated.0coldlane0legexcursions].[usr:Calculation_2025110100000007:qk:2]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.0coldlane0legexcursions].[usr:Calculation_2025110100000001:qk] + [federated.0coldlane0legexcursions].[usr:Calculation_2025110100000007:qk:2])</rows>
        <cols>[federated.0coldlane0legexcursions].[none:site:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Lot Budget Burn'>
      <layout-options><title><formatted-text><run>Stability budget used per lot</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='lot_budget' name='federated.0coldlane0lotbudget' /></datasources>
          <datasource-dependencies datasource='federated.0coldlane0lotbudget'>
            <column datatype='string' name='[lot_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[product]' role='dimension' type='nominal' />
            <column caption='Budget Used %' datatype='real' name='[Calculation_2025110100000005]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([minutes_used]) / SUM([allowance_minutes])' /></column>
            <column-instance column='[lot_id]' derivation='None' name='[none:lot_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[product]' derivation='None' name='[none:product:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2025110100000005]' derivation='User' name='[usr:Calculation_2025110100000005:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0coldlane0lotbudget].[none:lot_id:nk]' direction='DESC' using='[federated.0coldlane0lotbudget].[usr:Calculation_2025110100000005:qk]' />
          <aggregation value='true' />
        </view>
        <style><style-rule element='cell'><format attr='text-format' field='[federated.0coldlane0lotbudget].[usr:Calculation_2025110100000005:qk]' value='p0.0%' /></style-rule></style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.0coldlane0lotbudget].[none:product:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0coldlane0lotbudget].[usr:Calculation_2025110100000005:qk]</rows>
        <cols>[federated.0coldlane0lotbudget].[none:lot_id:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Monthly Trend'>
      <layout-options><title><formatted-text><run>Monthly excursion, indeterminate and reject rates and average MKT</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='shipment_summary' name='federated.0coldlane0shipmentsummary' /></datasources>
          <datasource-dependencies datasource='federated.0coldlane0shipmentsummary'>
            <column datatype='date' name='[ship_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[product]' role='dimension' type='nominal' />
            <column caption='Excursion Rate' datatype='real' name='[Calculation_2025110100000002]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([has_excursion]) / COUNTD([shipment_id])' /></column>
            <column caption='Indeterminate Rate' datatype='real' name='[Calculation_2025110100000003]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([is_indeterminate]) / COUNTD([shipment_id])' /></column>
            <column caption='Reject Rate' datatype='real' name='[Calculation_2025110100000004]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([is_reject]) / COUNTD([shipment_id])' /></column>
            <column caption='Avg MKT' datatype='real' name='[Calculation_2025110100000006]' role='measure' type='quantitative'><calculation class='tableau' formula='AVG([mkt_c])' /></column>
            <column-instance column='[ship_month]' derivation='Month-Trunc' name='[tmn:ship_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[product]' derivation='None' name='[none:product:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2025110100000002]' derivation='User' name='[usr:Calculation_2025110100000002:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2025110100000003]' derivation='User' name='[usr:Calculation_2025110100000003:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2025110100000004]' derivation='User' name='[usr:Calculation_2025110100000004:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2025110100000006]' derivation='User' name='[usr:Calculation_2025110100000006:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane y-axis-name='[federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000002:qk]'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0coldlane0shipmentsummary].[none:product:nk]' />
            </encodings>
          </pane>
          <pane y-axis-name='[federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000003:qk]'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0coldlane0shipmentsummary].[none:product:nk]' />
            </encodings>
          </pane>
          <pane y-axis-name='[federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000004:qk]'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0coldlane0shipmentsummary].[none:product:nk]' />
            </encodings>
          </pane>
          <pane y-axis-name='[federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000006:qk]'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.0coldlane0shipmentsummary].[none:product:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000002:qk] + [federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000003:qk] + [federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000004:qk] + [federated.0coldlane0shipmentsummary].[usr:Calculation_2025110100000006:qk])</rows>
        <cols>[federated.0coldlane0shipmentsummary].[tmn:ship_month:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
